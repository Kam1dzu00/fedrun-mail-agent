{
  "name": "fedrun-mail-agent",
  "version": "0.1.0",
  "description": "Compact TypeScript AI mail agent with Gmail ingestion, local classification, Telegram alerts, and safe auto-replies.",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build && node --test dist/test/*.test.js",
