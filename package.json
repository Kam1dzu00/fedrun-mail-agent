{
  "name": "fedrun-mail-agent",
  "version": "0.1.0",
  "description": "Compact TypeScript AI mail agent with Gmail triage, local policy enforcement, Telegram approvals, and offline demos.",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "build": "tsc -p tsconfig.json",
    "demo": "npm run build && node dist/src/demo/offline-demo.js",
    "evaluate": "npm run build && node dist/src/demo/evaluate.js",
    "start": "npm run build && node dist/src/index.js"
  },
  "keywords": [
    "ai-agent",
    "gmail",
    "telegram",
    "typescript",
    "email-automation",
    "human-in-the-loop",
    "prompt-injection"
  ],
  "author": "Mikhail Fedrunov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kam1dzu00/fedrun-mail-agent.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
